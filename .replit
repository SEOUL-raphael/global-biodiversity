modules = ["nodejs-24", "python-3.11", "postgresql-16"]

  [deployment]
  router = "application"
deploymentTarget = "cloudrun"

  [deployment.postBuild]
  args = ["pnpm", "store", "prune"]
  env = { "CI" = "true" }

  [workflows]
  runButton = "Project"

  [[workflows.workflow]]
  name = "Project"
  mode = "parallel"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "Cognee KG Service"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "artifacts/api-server: API Server"

  [[workflows.workflow]]
  name = "Cognee KG Service"
  author = "agent"

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd artifacts/cognee-service && PORT=5000 python3 main.py"

  [[workflows.workflow]]
  name = "artifacts/api-server: API Server"
  author = "agent"

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "pnpm --filter @workspace/api-server run dev"

  [agent]
  stack = "PNPM_WORKSPACE"
expertMode = true

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 23183
externalPort = 3001

  [nix]
  channel = "stable-25_05"

  [userenv]

  [userenv.shared]
  OPENAI_BASE_URL = "https://api.minimaxi.chat/v1"
DISABLE_BG_ENRICH = "1"
DISABLE_BG_INGEST = "1"
SUPABASE_TRANSACTION_POOLER_TEMPLATE = "postgresql://postgres.ltmrtmavgjlflvcbahpy:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_PROVIDER = "supabase"

[userenv.production]
BG_INGEST_MAX_TICKS_PER_DAY = "200"
BG_ENRICH_MAX_PER_DAY = "500"

[userenv.development]
BG_INGEST_MAX_TICKS_PER_DAY = "480"
  